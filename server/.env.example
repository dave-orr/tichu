FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
ALLOWED_ORIGINS=https://tichu.squidbox.com
# Set to 1 only when running behind a trusted reverse proxy (e.g. nginx) so the
# X-Forwarded-For header can be trusted for per-IP connection limiting. Leave
# unset for direct/local deployments — otherwise clients can spoof their IP.
TRUST_PROXY=1
# Bearer token for the operator dashboard at /admin and scripts/rooms.sh
# (live rooms, player names, room codes). Leave unset to disable it. Generate
# one with: openssl rand -hex 24
ADMIN_TOKEN=
# Bearer token for the AI player API under /api (bots: docs/AI_API.md). Leave
# unset to disable the API. Generate one with: openssl rand -hex 24
BOT_TOKEN=
# AI suggestions in hand reviews run the AI engine (dave-orr/tichu-ai) built
# next to this repo (deploy.sh builds it). All optional: TICHU_AI is the
# checkout (default ../Tichu-ai), AI_REVIEW_BOT the bot spec (default best),
# AI_REVIEW_THREADS the threads per hand (default 2).
# TICHU_AI=
# AI_REVIEW_BOT=best
# AI_REVIEW_THREADS=2
